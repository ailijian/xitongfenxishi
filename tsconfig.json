{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts",
    "playwright.staging.config.ts",
    "playwright.audit.config.ts",
    "playwright.beginner.config.ts",
    "playwright.full-course.config.ts"
  ]
}
