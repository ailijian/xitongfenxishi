{
  "name": "ruankao-sprint-system-analyst",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "data:import": "tsx scripts/import-content.ts",
    "data:check": "tsx scripts/import-content.ts --check",
    "lessons:check": "tsx scripts/check-beginner-content.ts && node scripts/build-lesson-diagrams.mjs --check && tsx scripts/check-full-course.ts",
    "build": "npm run data:check && npm run lessons:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "test:pwa": "npm run build && playwright test --config playwright.production.config.ts",
    "test:beginner": "playwright test --config playwright.beginner.config.ts",
    "test:full-course": "playwright test --config playwright.full-course.config.ts",
    "diagrams:render": "node scripts/render-expanded-diagrams.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "mermaid": "12.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3"
  }
}
