{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# Hashed build assets can be cached; missing assets must remain real 404s.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@files path /icons/* /*.* /_headers /_redirects
	handle @files {
		header Cache-Control no-cache
		file_server
	}

	# BrowserRouter navigations always receive the current index, including refresh.
	handle {
		header Cache-Control no-cache
		rewrite * /index.html
		file_server
	}
}
